{
  "expo": {
    "name": "EduDeca",
    "slug": "edudeca",
    "scheme": "edudeca",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0E14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edudeca.mobile"
    },
    "android": {
      "package": "com.edudeca.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14"
      }
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
